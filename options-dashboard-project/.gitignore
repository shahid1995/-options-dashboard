# Secrets — never commit real credentials
.env
.env.local
.env.*.local
.env.*
!.env.example

# Token cache — must never be committed
.token_cache/
*.token_cache
upstox_token.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / Next.js
node_modules/
.next/
out/

# SQLite databases — never commit production/test DB files
*.db
*.db-wal
*.db-shm
*.db-journal
*.db-corrupted

# Freebuff workspace
.freebuff/
